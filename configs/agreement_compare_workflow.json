{
  "seed": 42,
  "model_name": "Qwen3-1.7B",
  "output_dir": "output/agreement_compare_workflow",
  "dataset_dir": "dataset",
  "sample_limit_per_task": 50,
  "layer_indices": [0, 3, 6, 9, 12, 15, 18, 21, 24, 27],
  "task_layer_overrides": {
    "blimp": [0, 3, 6, 9, 12, 15, 18, 21, 24, 27]
  },
  "resume": {
    "enabled": true,
    "skip_if_layer_file_exists": true,
    "require_fingerprint_match": true,
    "save_summary_every_layer": true,
    "reuse_existing_ppl": true
  },
  "methods": {
    "dft_noise": {
      "enabled": true,
      "op_type": "band_noise",
      "noise_std": 1.0,
      "r": 0.3
    },
    "random_zero": {
      "enabled": true,
      "op_type": "act_zero",
      "noise_std": 1.0,
      "selector": "random",
      "r": 0.3
    },
    "diffmean_zero": {
      "enabled": true,
      "op_type": "act_zero",
      "noise_std": 1.0,
      "selector": "diffmean",
      "r": 0.2,
      "calibration_size": 20,
      "topk_dims_mode": "from_r"
    },
    "probing_zero": {
      "enabled": true,
      "op_type": "act_zero",
      "noise_std": 1.0,
      "selector": "probing",
      "r": 0.2,
      "calibration_size": 20,
      "topk_dims_mode": "from_r",
      "probing_steps": 200,
      "probing_lr": 0.1,
      "probing_weight_decay": 0.0001
    }
  },
  "energy_alignment": {
    "enabled": false,
    "reference_method": "dft_noise",
    "calibration_size": 8,
    "min_noise_std": 0.0001,
    "max_noise_std": 10.0
  },
  "generation": {
    "max_new_tokens_choice": 200,
    "max_new_tokens_boolq": 200,
    "max_new_tokens_mawps": 200,
    "temperature": 0.0,
    "max_time": 30.0
  },
  "ppl": {
    "enabled": false,
    "dataset_path": "dataset/ppl_wikitext2",
    "split": "test",
    "sample_limit": 20,
    "max_length": 256
  },
  "tasks": {
    "blimp": {
      "enabled": true,
      "dataset_path": "dataset/blimp",
      "split": "train"
    },
    "boolq": {
      "enabled": false,
      "dataset_path": "dataset/boolq",
      "split": "validation"
    },
    "copa": {
      "enabled": false,
      "dataset_path": "dataset/copa",
      "split": "validation"
    },
    "mawps": {
      "enabled": false,
      "dataset_path": "dataset/mawps",
      "split": "validation"
    }
  }
}
